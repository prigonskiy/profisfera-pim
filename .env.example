# Скопируйте в .env и заполните. Локально можно не создавать — настройки имеют
# рабочие значения по умолчанию (SQLite, DEBUG=1). На проде .env обязателен.

# Секретный ключ Django (на проде — длинная случайная строка).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# 1 — разработка, 0 — продакшен
DEBUG=1

# Разрешённые хосты через запятую (на проде — IP или домен)
ALLOWED_HOSTS=*

# Доверенные источники для CSRF, со схемой (нужно для админки не на localhost).
# Напр.: http://1.2.3.4  или  https://example.com
CSRF_TRUSTED_ORIGINS=

# Куки только по HTTPS: 1 — когда есть домен с TLS, иначе 0
COOKIE_SECURE=0

# Если за HTTPS-прокси (nginx + Let's Encrypt): 1, иначе не указывать
# BEHIND_TLS_PROXY=1

# База данных. Оставьте пусто для SQLite. Для Postgres укажите postgres:
# DB_ENGINE=postgres
# DB_NAME=pim
# DB_USER=pim
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432
