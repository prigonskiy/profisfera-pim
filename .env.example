# Скопируйте в .env и заполните. Локально можно не создавать — настройки имеют
# рабочие значения по умолчанию (SQLite, DEBUG=1). На проде .env обязателен.

# Секретный ключ Django (на проде — длинная случайная строка).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# 1 — разработка, 0 — продакшен
DEBUG=1

# Разрешённые хосты через запятую (на проде — IP или домен)
ALLOWED_HOSTS=*

# Доверенные источники для CSRF, со схемой (нужно для админки не на localhost).
# Напр.: http://1.2.3.4  или  https://example.com
CSRF_TRUSTED_ORIGINS=

# Куки только по HTTPS: 1 — когда есть домен с TLS, иначе 0
COOKIE_SECURE=0

# Если за HTTPS-прокси (nginx + Let's Encrypt): 1, иначе не указывать
# BEHIND_TLS_PROXY=1

# База данных. Оставьте пусто для SQLite. Для Postgres укажите postgres:
# DB_ENGINE=postgres
# DB_NAME=pim
# DB_USER=pim
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# CORS: источники витрины, которым разрешены запросы к API.
# Со схемой, БЕЗ пути и без слэша в конце, через запятую.
# Напр.: https://prigonskiy.github.io
# CORS_ALLOWED_ORIGINS=

# Троттлинг API (лимиты частоты). По умолчанию: анонимы 300/min, авторизованные 1000/min.
# Формат: "<число>/<period>", period = sec|min|hour|day.
# THROTTLE_ANON=300/min
# THROTTLE_USER=1000/min

# Пересборка витрины (GitHub repository_dispatch).
# GITHUB_DISPATCH_TOKEN — fine-grained PAT с правом Contents: Read and write
#   ТОЛЬКО на репозиторий витрины. Секрет, в гит не коммитить.
# STOREFRONT_REPO — репозиторий витрины вида "owner/repo".
# STOREFRONT_DISPATCH_EVENT — тип события (должен совпадать с types: в pages.yml витрины),
#   по умолчанию "rebuild".
# GITHUB_DISPATCH_TOKEN=github_pat_xxx
# STOREFRONT_REPO=prigonskiy/profisfera-shop
# STOREFRONT_DISPATCH_EVENT=rebuild
