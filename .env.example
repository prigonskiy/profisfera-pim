# Скопируйте в .env и заполните на сервере. Локально можно не создавать —
# настройки имеют рабочие значения по умолчанию (SQLite, DEBUG=1).

# Секретный ключ Django (обязательно сменить на проде, длинная случайная строка)
SECRET_KEY=change-me-to-a-long-random-string

# 1 — разработка, 0 — продакшен
DEBUG=1

# Разрешённые домены через запятую (на проде, напр.: example.com,www.example.com)
ALLOWED_HOSTS=*

# База данных. Оставьте пусто для SQLite. Для Postgres укажите postgres:
# DB_ENGINE=postgres
# DB_NAME=pim
# DB_USER=pim
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432
