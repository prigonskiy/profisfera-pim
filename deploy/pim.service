# systemd-сервис gunicorn. Копируется в /etc/systemd/system/pim.service
[Unit]
Description=ProfiSfera PIM (gunicorn)
After=network.target postgresql.service

[Service]
User=pim
Group=pim
WorkingDirectory=/srv/pim
ExecStart=/srv/pim/venv/bin/gunicorn pim.wsgi:application \
    --bind 127.0.0.1:8001 \
    --workers 3
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
